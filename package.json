{
  "name": "futurisma-race",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "validate:assets": "node scripts/validate-assets.mjs",
    "validate:race-presence": "node scripts/validate-race-presence.mjs",
    "validate:apron": "node scripts/validate-apron.mjs",
    "validate:audio": "node scripts/validate-audio-timing.mjs",
    "validate:camera": "node scripts/validate-camera-feedback.mjs",
    "validate:control": "node scripts/validate-control-mode.mjs",
    "validate:graphics": "node scripts/validate-graphics-resources.mjs",
    "validate:frames": "node scripts/validate-frame-scheduling.mjs",
    "validate:presentation": "node scripts/validate-presentation.mjs",
    "validate:build": "node scripts/validate-build.mjs",
    "validate:map": "node scripts/validate-map.mjs",
    "validate:map02": "node scripts/validate-map02.mjs",
    "validate:environment": "node scripts/validate-greenwater-package.mjs",
    "validate:environment:history": "node scripts/validate-greenwater-package.mjs GREENWATER_ENVIRONMENT_STAGE2.zip GREENWATER_ENVIRONMENT_STAGE1.zip",
    "validate:environment:accepted": "node scripts/validate-greenwater-package.mjs GREENWATER_ENVIRONMENT_v1.0.zip GREENWATER_ENVIRONMENT_STAGE2.zip",
    "validate:package-boundary": "node scripts/validate-package-boundary.mjs",
    "validate:ghost": "node scripts/validate-ghost.mjs",
    "validate:persistence": "node scripts/validate-persistence.mjs",
    "validate:physics": "node scripts/validate-physics.mjs",
    "validate:race": "node scripts/validate-race-rules.mjs",
    "validate:rivals": "node scripts/validate-rivals.mjs",
    "validate:render": "node scripts/validate-render-quality.mjs",
    "validate:lighting": "node scripts/validate-lighting.mjs",
    "validate:living-world": "node scripts/validate-living-world.mjs",
    "validate:minimap": "node scripts/validate-minimap.mjs",
    "validate:seams": "node scripts/validate-module-seams.mjs",
    "validate:shadows": "node scripts/validate-shadows.mjs",
    "validate:security": "node scripts/validate-security.mjs",
    "test:code": "npm run validate:race-presence && npm run validate:map && npm run validate:map02 && npm run validate:package-boundary && npm run validate:physics && npm run validate:apron && npm run validate:drivable-limits && npm run validate:race && npm run validate:rivals && npm run validate:control && npm run validate:audio && npm run validate:camera && npm run validate:presentation && npm run validate:graphics && npm run validate:frames && npm run validate:render && npm run validate:lighting && npm run validate:living-world && npm run validate:decal-cells && npm run validate:art-pass && npm run validate:furniture && npm run validate:minimap && npm run validate:seams && npm run validate:shadows && npm run validate:persistence && npm run validate:ghost && npm run validate:security && npm run build && npm run validate:build",
    "test:archives": "npm run validate:assets && npm run validate:environment:history && npm run validate:environment:accepted",
    "test": "npm run test:code && npm run test:archives",
    "validate:art-pass": "node scripts/validate-art-pass.mjs",
    "validate:furniture": "node scripts/validate-furniture.mjs",
    "validate:drivable-limits": "node scripts/validate-drivable-limits.mjs",
    "validate:decal-cells": "node scripts/derive-decal-cells.mjs --check"
  },
  "dependencies": {
    "three": "0.184.0"
  },
  "devDependencies": {
    "@types/three": "0.185.4",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
