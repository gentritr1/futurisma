node_modules/
dist/
.DS_Store
*.log
.vite/

# Accepted art packages live under artifacts/ and are resolved through
# scripts/lib/archive-root.mjs. Only the four already-tracked packages stay in
# git; every other archive is a local provenance payload, not source.
artifacts/**
!artifacts/GREENWATER_ENVIRONMENT_PRODUCTION_INPUT_v1.0.zip
!artifacts/GREENWATER_MAP01_v1.0.zip
!artifacts/TOTEM_Phase1_v1.0-patch1.zip
!artifacts/TOTEM_Phase1_v1.0.zip
.claude/worktrees/
shots/
assets-in/
# Python bytecode from the tracked preparation scripts.
__pycache__/

# M1 local soundtrack. The repository is PUBLIC: the mixes a player imports are
# somebody else's recordings and must never be committed, so the directory is
# ignored down to the file and only the placeholder that keeps it in the tree is
# excepted. scripts/validate-soundtrack.mjs asserts both halves of this against
# `git ls-files` on every run of `npm run test:code`.
public/assets/audio/music/*
!public/assets/audio/music/.gitkeep
