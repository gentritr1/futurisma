  "cold.win": "[frames, expected at 60 Hz] in the 20 s window after the clock",
  "cold.max": "worst rAF delta in that window",
  "cold.progs": "programs created (shaderSource) in that window",
  "cold.diag": "renderer.info.programs.length at clock and +20 s",
  "warmupMs": "[FUTURISMA_WARMUP] totalMs"
 },
