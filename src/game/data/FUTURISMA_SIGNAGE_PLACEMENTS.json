  },
  "PALE_HARVEST": {
   "status": "new",
   "role": "solar salt operator, Bitterpan",
   "justification": "Bitterpan is a working salt pan with harvester rigs and a loadout tower. Somebody harvests it. Bone-on-salt with a halite lozenge; the only board whose ground is the same colour as its site."
  },
  "SODIUM_ROW": {
   "status": "new",
   "role": "bulk propellant contractor, Greenwater",
   "justification": "Greenwater already has a sector called FUEL_ROW and the lighting brief already warms it toward sodium service light. The name is read off the map instead of invented over it."
  },
  "AEROLIFT_VII": {
   "status": "new",
   "role": "airframe repair, Greenwater",
   "justification": "Hangar Six is an aircraft hangar with a collapsed-boom crane. Naming the trade that occupies it is what turns the hangar from scenery into a tenant, and it is the direct source of 'repaired aerospace machinery'."
  },
  "GREENWATER_FIELD_AUTHORITY": {
   "status": "new",
   "role": "site operator, Greenwater",
   "justification": "The only civic voice in the set. It owns the Cradle fascia, so the gate reads as a facility gate rather than a race arch."
  }
